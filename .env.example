# Local development only. Copy this file to .env (git ignores it) before the first
# `docker compose up`. Docker gives each password to its database container and to Vault;
# the services never see this file, they read their credentials from Vault.
#
# If you change a password after the first start, recreate the databases:
#   docker compose down -v && docker compose up -d --wait

# Root token of the dev Vault, for the UI (http://localhost:8200) and the vault CLI.
VAULT_ROOT_TOKEN=banking-dev-root

MONGO_ROOT_PASSWORD=mongo-admin-dev
CUSTOMER_DB_PASSWORD=customers-dev
ACCOUNT_DB_PASSWORD=accounts-dev
CREDIT_DB_PASSWORD=credits-dev
PRODUCT_DB_PASSWORD=products-dev
# Password of product-redis, the cache of product-service.
PRODUCT_REDIS_PASSWORD=product-cache-dev
TRANSACTION_DB_PASSWORD=transactions-dev
CARD_DB_PASSWORD=cards-dev
YANKI_DB_PASSWORD=yanki-dev
AUTH_DB_PASSWORD=auth-dev

# auth-service. Password of the first administrator (user "admin"), created the first time the
# service starts; the Postman collections log in with it.
AUTH_ADMIN_PASSWORD=Admin-dev-2026
# Encrypts the private key that signs the tokens before it is stored in auth_db. Changing it
# makes auth-service create a new signing key.
AUTH_KEY_ENCRYPTION_SECRET=auth-key-encryption-dev
# Secrets account-service and credit-service present to get the token they call other
# services with.
ACCOUNT_SERVICE_CLIENT_SECRET=account-service-dev
CREDIT_SERVICE_CLIENT_SECRET=credit-service-dev

# Only for config-server with the git backend against a private repository (a GitHub
# personal access token). Leave empty when it runs with the native profile.
CONFIG_GIT_USERNAME=
CONFIG_GIT_TOKEN=
