# Local development only. Copy this file to .env (git ignores it) before the first
# `docker compose up`. Docker gives each password to its database container and to Vault;
# the services never see this file, they read their credentials from Vault.
#
# If you change a password after the first start, recreate the databases:
#   docker compose down -v && docker compose up -d --wait

# Root token of the dev Vault, for the UI (http://localhost:8200) and the vault CLI.
VAULT_ROOT_TOKEN=banking-dev-root

MONGO_ROOT_PASSWORD=mongo-admin-dev
CUSTOMER_DB_PASSWORD=customers-dev
ACCOUNT_DB_PASSWORD=accounts-dev
CREDIT_DB_PASSWORD=credits-dev

# Only for config-server with the git backend against a private repository (a GitHub
# personal access token). Leave empty when it runs with the native profile.
CONFIG_GIT_USERNAME=
CONFIG_GIT_TOKEN=
